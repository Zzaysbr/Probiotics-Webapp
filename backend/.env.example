# Copy to .env and supply your local values. Do not commit real secrets.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=probiotic_shop
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional TTF path (Windows automatically uses C:/Windows/Fonts/tahoma.ttf)
RECEIPT_FONT_PATH=
DEMO_MODE=true
SHOP_NAME=Probiotic Shop
# Leave the next fields empty to use the university reference/demo defaults.
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
BANK_NAME=
BANK_ACCOUNT=
BANK_OWNER=

# Unpaid reservations expire automatically after this many hours (1-168).
ORDER_PAYMENT_HOURS=24
