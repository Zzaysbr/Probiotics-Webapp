{
  "info": {
    "name": "Probiotic Shop — JWT and Admin verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a demo/test database. Creates one test customer and one hidden test product. Contains no production secrets."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminUsername",
      "value": "admin-demo"
    },
    {
      "key": "adminPassword",
      "value": "DemoShop123!"
    },
    {
      "key": "invalidToken",
      "value": "invalid-token"
    }
  ],
  "item": [
    {
      "name": "01 Missing JWT is denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\",String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Invalid JWT is denied",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{invalidToken}}"
          }
        ],
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Weak password is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"weak-{{runId}}\", \"email\": \"weak-{{runId}}@example.invalid\", \"full_name\": \"Postman Test\", \"password\": \"weak\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Register cannot grant admin role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"postman-{{runId}}\", \"email\": \"postman-{{runId}}@example.invalid\", \"full_name\": \"Postman Test\", \"phone\": \"0000000000\", \"password\": \"Postman123!\", \"role\": \"admin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Customer login returns JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"postman-{{runId}}\", \"password\": \"Postman123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set(\"customerToken\",d.token);pm.test(\"registration forced customer\",()=>pm.expect(d.user.role).to.eql(\"customer\"));",
              "pm.test(\"JWT has three segments\",()=>pm.expect(d.token.split(\".\").length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Valid JWT accesses protected products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"products array\",()=>pm.expect(pm.response.json().data).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Customer cannot create products",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{adminUsername}}\", \"password\": \"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\",pm.response.json().token);pm.test(\"admin role\",()=>pm.expect(pm.response.json().user.role).to.eql(\"admin\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Load category and brand IDs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set(\"categoryId\",d.categories[0].category_id);pm.collectionVariables.set(\"brandId\",d.brands[0].brand_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Admin inserts product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"POSTMAN-{{runId}}\", \"product_name\": \"Postman Test Product\", \"price\": \"199.50\", \"stock_qty\": 5, \"category_id\": \"{{categoryId}}\", \"brand_id\": \"{{brandId}}\", \"description\": \"Temporary verification item\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"productId\",pm.response.json().product_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Admin searches product",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/products?search=POSTMAN-{{runId}}&all=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"search matches\",()=>pm.expect(pm.response.json().total).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Admin updates product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"POSTMAN-{{runId}}\", \"product_name\": \"Postman Test Product\", \"price\": \"209.50\", \"stock_qty\": 5, \"category_id\": \"{{categoryId}}\", \"brand_id\": \"{{brandId}}\", \"description\": \"Temporary verification item\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Admin deletes product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Hidden product absent for customer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/products?search=POSTMAN-{{runId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"soft deleted\",()=>pm.expect(pm.response.json().total).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Customer cannot read dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Admin dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}