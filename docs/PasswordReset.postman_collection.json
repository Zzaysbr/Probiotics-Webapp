{
  "info": {
    "name": "Probiotic Shop — Password reset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Request a link, copy resetToken from the delivered email, then run the reset request. Never put real passwords or tokens in exported collection files."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "resetEmail",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Request reset link by email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/forgot-password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{resetEmail}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Token not leaked in API\",()=>pm.expect(pm.response.json()).not.to.have.property(\"resetTokenForTesting\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Reset using token FROM EMAIL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{resetEmail}}\", \"token\": \"{{resetToken}}\", \"newPassword\": \"{{newPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Login with new password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{resetEmail}}\", \"password\": \"{{newPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"JWT issued\",()=>pm.expect(pm.response.json().token).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Used token must be refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{resetEmail}}\", \"token\": \"{{resetToken}}\", \"newPassword\": \"{{newPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
